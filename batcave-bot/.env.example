# Environment variables for BatCave Bot
# Copy this file to .env and fill in your values

# Bot nickname on IRC
BOT_NICK=BatCaveBot

# Channel to join (include the #)
BOT_CHANNEL=#batcave

# NickServ password (optional, for registered nick)
NICKSERV_PASS=

# Admin nickname for special commands (optional)
ADMIN_NICK=
